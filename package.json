{
  "name": "the-child-explainable-simulation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "test": "vitest run --exclude Evidence/**",
    "audit:rules": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/skills/auditing-rules-of-life/scripts/audit-harness.ps1 -Phase Prepare",
    "audit:rules:finalize": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/skills/auditing-rules-of-life/scripts/audit-harness.ps1 -Phase Finalize",
    "audit:rules:self-test": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/skills/auditing-rules-of-life/scripts/audit-harness.ps1 -Phase SelfTest",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
